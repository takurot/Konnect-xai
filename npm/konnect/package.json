    "@konnect-xai/konnect-linux-arm64": "0.0.0-development",
    "@konnect-xai/konnect-darwin-arm64": "0.0.0-development",
    "@konnect-xai/konnect-darwin-x64": "0.0.0-development",
    "@konnect-xai/konnect-win32-x64": "0.0.0-development"
  }
}
