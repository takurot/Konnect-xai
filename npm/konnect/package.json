{
  "name": "@konnect-xai/konnect",
  "description": "Konnect: a KiCad MCP server. Run it with npx; the platform binary is installed automatically.",
  "version": "0.0.0-development",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takurot/Konnect-xai.git"
  },
