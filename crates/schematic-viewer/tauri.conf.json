{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konnect Schematic Viewer",
  "version": "0.14.0",
  "identifier": "com.github.mixelpixx.konnect.viewer",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'"
    },
    "windows": [
      {
        "title": "Schematic Viewer — Konnect",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
